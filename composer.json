{
    "name": "arvan-reseller/arvan-reseller",
    "description": "White-label ArvanCloud reseller platform for WordPress — dev tooling only; the plugin has zero runtime Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "nikic/php-parser": "^5",
        "phpunit/phpunit": "^11 || ^12"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php bin/php74-check.php",
        "check:php74": "@php bin/php74-check.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
